# ─── Rastera Engine — Environment Variables ───────────────────────────────────
# Copy this file to .env on your VPS and fill in real values.
# NEVER commit .env to git.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
# In docker-compose, the DB hostname is "db" (internal network alias).
DATABASE_URL=postgresql+psycopg://rastera:CHANGE_ME@db:5432/rastera
DB_PASSWORD=CHANGE_ME

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://rastera.io,https://www.rastera.io,https://<your-vercel-app>.vercel.app

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
